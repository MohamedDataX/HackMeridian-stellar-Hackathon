{
  "name": "@stellar-scaffold/ui",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "prestart": "node scripts/dev-guard.mjs",
    "start": "npm start --workspace app",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deploy": "npm run build -w app && cd app && npx -y wrangler@4.152.0 pages deploy dist --project-name zepho --branch main"
  },
  "workspaces": [
    "app",
    "app-lib",
    "app-lib/clients/*",
    "e2e"
  ],
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "prettier": "@theahaco/ts-config/prettier"
}
