{
  "name": "@stellar-scaffold/ui-react",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm start",
    "start": "concurrently --kill-others-on-fail --names stellar,vite -c gray,green --pad-prefix \"stellar scaffold watch\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "prepare": "husky",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@stellar-scaffold/app-lib": "*",
    "@tanstack/react-query": "^5.105.1",
    "@theahaco/contract-explorer": "^1.4.0",
    "@theahaco/ts-config": "^1.3.2",
    "lossless-json": "^4.3.3",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.14.0",
    "glob": "^13.0.6",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "lint-staged": {
    "**/*": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@theahaco/ts-config/prettier",
  "engines": {
    "stellar-scaffold": ">=0.0.24"
  }
}
